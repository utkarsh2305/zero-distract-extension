{
  "manifest_version": 3,
  "name": "Zero Distract",
  "version": "1.0.0",
  "description": "Block social media feeds, get smart nudges, and track distraction patterns. Reclaim your focus with Zero Distract.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.reddit.com/*",
        "https://reddit.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "settings.html", "onboarding.html"],
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.reddit.com/*",
        "https://reddit.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ]
    }
  ]
}
