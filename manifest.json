{
  "manifest_version": 3,
  "name": "Zero Distract",
  "version": "1.0.0",
  "description": "Reclaim your focus with intelligent nudges. Zero Distract blocks social media feeds and sends smart reminders when you spend too much time on distracting sites. Track your patterns, set work hours, and build better digital habits.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "settings.html", "onboarding.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
